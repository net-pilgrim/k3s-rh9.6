[Unit]
Description=Forgejo Actions Host Worker Daemon
Documentation=https://forgejo.org/docs/latest/admin/actions/
After=network-online.target k3s.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/forgejo-runner
EnvironmentFile=-/etc/forgejo-runner/runner.env
ExecStartPre=/usr/local/bin/forgejo-runner-register
ExecStart=/usr/local/bin/forgejo-runner daemon --config /etc/forgejo-runner/config.yaml
Restart=always
RestartSec=5s
LimitNOFILE=65536
LimitNPROC=65536
KillMode=process
TasksMax=infinity

[Install]
WantedBy=multi-user.target
