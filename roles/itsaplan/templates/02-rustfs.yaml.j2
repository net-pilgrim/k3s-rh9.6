apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: itsaplan-minio
  namespace: {{ itsaplan_namespace }}
spec:
  serviceName: itsaplan-minio
  replicas: 1
  selector:
    matchLabels:
      app: itsaplan-minio
  template:
    metadata:
      labels:
        app: itsaplan-minio
    spec:
      containers:
        - name: rustfs
          image: rustfs/rustfs:1.0.0
          env:
            - name: RUSTFS_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: itsaplan-secrets
                  key: S3_ACCESS_KEY_ID
            - name: RUSTFS_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: itsaplan-secrets
                  key: S3_SECRET_ACCESS_KEY
          ports:
            - containerPort: 9000
              name: s3
            - containerPort: 9001
              name: console
          volumeMounts:
            - name: minio-data
              mountPath: /data
          readinessProbe:
            httpGet:
              path: /health
              port: 9000
            initialDelaySeconds: 5
            periodSeconds: 10
  volumeClaimTemplates:
    - metadata:
        name: minio-data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: "local-path"
        resources:
          requests:
            storage: 10Gi
---
apiVersion: v1
kind: Service
metadata:
  name: itsaplan-minio
  namespace: {{ itsaplan_namespace }}
spec:
  type: ClusterIP
  ports:
    - port: 9000
      targetPort: 9000
      name: s3
    - port: 9001
      targetPort: 9001
      name: console
  selector:
    app: itsaplan-minio
---
apiVersion: batch/v1
kind: Job
metadata:
  name: itsaplan-bucket-init
  namespace: {{ itsaplan_namespace }}
spec:
  ttlSecondsAfterFinished: 300
  template:
    spec:
      restartPolicy: OnFailure
      containers:
        - name: bucket-init
          image: curlimages/curl:latest
          envFrom:
            - secretRef:
                name: itsaplan-secrets
          command:
            - /bin/sh
            - -c
            - |
              echo "Waiting for RustFS/MinIO to be available..."
              while ! curl -s -f http://itsaplan-minio:9000/health; do
                sleep 2
              done
              echo "Creating attachment bucket ${S3_BUCKET}..."
              curl -fsS -X PUT --aws-sigv4 "aws:amz:us-east-1:s3" \
                --user "${S3_ACCESS_KEY_ID}:${S3_SECRET_ACCESS_KEY}" \
                "http://itsaplan-minio:9000/${S3_BUCKET}" || echo "Bucket already exists or initialized"
              echo "Bucket initialization complete."
