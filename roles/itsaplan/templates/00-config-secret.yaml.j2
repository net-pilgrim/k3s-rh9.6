apiVersion: v1
kind: Secret
metadata:
  name: itsaplan-secrets
  namespace: {{ itsaplan_namespace }}
type: Opaque
stringData:
  POSTGRES_USER: "{{ itsaplan_db_user }}"
  POSTGRES_PASSWORD: "{{ itsaplan_db_password }}"
  POSTGRES_DB: "{{ itsaplan_db_name }}"
  DATABASE_URL: "postgres://{{ itsaplan_db_user }}:{{ itsaplan_db_password }}@itsaplan-postgres:5432/{{ itsaplan_db_name }}"
  S3_ACCESS_KEY_ID: "{{ itsaplan_minio_user }}"
  S3_SECRET_ACCESS_KEY: "{{ itsaplan_minio_secret }}"
  S3_BUCKET: "{{ itsaplan_s3_bucket }}"
  BETTER_AUTH_SECRET: "{{ itsaplan_betterauth_secret }}"
  APP_ENCRYPTION_KEY: "{{ itsaplan_app_encryption_key }}"
  API_URL: "https://{{ itsaplan_api_host }}"
  APP_URL: "https://{{ itsaplan_web_host }}"
