# Forgejo Helm Values Configuration
image:
  rootless: true

ingress:
  enabled: true
  className: traefik
  annotations:
    cert-manager.io/cluster-issuer: "{{ cert_issuer }}"
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
  hosts:
    - host: "{{ forgejo_host }}"
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: forgejo-tls
      hosts:
        - "{{ forgejo_host }}"

persistence:
  enabled: true
  storageClass: "local-path"
  accessModes:
    - ReadWriteOnce
  size: "{{ forgejo_storage_size }}"

service:
  http:
    type: ClusterIP
    port: 3000
  ssh:
    type: NodePort
    port: 22
    nodePort: 32222

gitea:
  admin:
    existingSecret: ""
    username: "{{ forgejo_admin_user }}"
    password: "{{ forgejo_admin_password }}"
    email: "{{ forgejo_admin_email }}"
  config:
    APP_NAME: "Forgejo DevOps & CI/CD Platform"
    RUN_MODE: "prod"
    server:
      ROOT_URL: "https://{{ forgejo_host }}/"
      DOMAIN: "{{ forgejo_host }}"
      SSH_DOMAIN: "{{ forgejo_host }}"
      SSH_PORT: 32222
      SSH_LISTEN_PORT: 2222
      OFFLINE_MODE: false
    actions:
      ENABLED: true
      DEFAULT_ACTIONS_URL: "github"
    repository:
      DEFAULT_BRANCH: "main"
      ENABLE_PUSH_CREATE_USER: true
      ENABLE_PUSH_CREATE_ORG: true
    service:
      DISABLE_REGISTRATION: false
      ALLOW_ONLY_EXTERNAL_REGISTRATION: false
      SHOW_REGISTRATION_BUTTON: true
    security:
      INSTALL_LOCK: true
